# Both are optional. Empty means "same origin", which is what the Vite dev
# proxy and the nginx container provide. Set them when the frontend is deployed
# without a reverse proxy in front of the data API and the Go gateway.

# Python data API (FastAPI), e.g. https://api.example.org
VITE_API_URL=

# Go gateway for the hex chat (SSE), e.g. https://gateway.example.org
VITE_GATEWAY_URL=
