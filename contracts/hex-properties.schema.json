{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wohnindex.local/contracts/hex-properties.schema.json",
  "title": "hexes.geojson feature properties",
  "description": "Contract between the Python pipeline (producer), hex-svc (Go consumer) and the frontend scoring engine (TypeScript consumer). Validated on every export by pipeline.contract.validate_feature_properties.",
  "x-pipeline-version": 16,
  "type": "object",
  "additionalProperties": true,
  "required": [
    "h3",
    "s_living",
    "s_daily_life",
    "s_walk",
    "s_walking_quality",
    "s_transit",
    "s_green",
    "s_quiet",
    "s_housing_value",
    "s_urban_form",
    "s_center",
    "s_urban_activity",
    "s_business",
    "s_transport",
    "s_noise",
    "center_min",
    "urban_activity",
    "business_count",
    "transport_score",
    "green_dist_m",
    "green_access",
    "noise_db"
  ],
  "properties": {
    "h3": { "type": "string", "description": "H3 cell index (resolution from meta.h3_res)" },

    "s_living": { "$ref": "#/$defs/score", "description": "Objective Living Score (objective-v2)" },
    "s_objective": { "$ref": "#/$defs/score", "description": "Alias of s_living" },
    "s_daily_life": { "$ref": "#/$defs/score" },
    "s_daily_needs": { "$ref": "#/$defs/score", "description": "Legacy alias of s_daily_life" },
    "s_walk": { "$ref": "#/$defs/score" },
    "s_walking_quality": { "$ref": "#/$defs/score", "description": "Legacy alias of s_walk" },
    "s_transit": { "$ref": "#/$defs/score" },
    "s_transit_service": { "$ref": "#/$defs/score", "description": "Legacy alias of s_transit" },
    "s_green": { "$ref": "#/$defs/score" },
    "s_green_strict": { "$ref": "#/$defs/score" },
    "s_quiet": { "$ref": "#/$defs/score" },
    "s_noise": { "$ref": "#/$defs/score", "description": "Quiet-is-high alias of s_quiet" },
    "s_housing_affordability": { "$ref": "#/$defs/score" },
    "s_housing_value": { "$ref": "#/$defs/score", "description": "Alias of s_housing_affordability" },
    "s_urban_form": { "$ref": "#/$defs/score" },
    "s_center": { "$ref": "#/$defs/score", "description": "City-normalised centrality (informational, weight 0)" },
    "s_center_strict": { "$ref": "#/$defs/score" },
    "s_urban_activity": { "$ref": "#/$defs/score" },
    "s_business": { "$ref": "#/$defs/score", "description": "Alias of s_urban_activity" },
    "s_transport": { "$ref": "#/$defs/score" },
    "s_heat": { "$ref": "#/$defs/score" },
    "s_traffic_safety": { "$ref": "#/$defs/score" },
    "s_traffic_safety_strict": { "$ref": "#/$defs/score" },
    "s_housing": { "$ref": "#/$defs/score" },
    "s_density": { "$ref": "#/$defs/score" },

    "s_daily_life_city": { "$ref": "#/$defs/score", "description": "City-normalised copy, diagnostics only" },
    "s_walk_city": { "$ref": "#/$defs/score" },
    "s_transit_city": { "$ref": "#/$defs/score" },
    "s_green_city": { "$ref": "#/$defs/score" },
    "s_quiet_city": { "$ref": "#/$defs/score" },

    "s_match_centrality": { "$ref": "#/$defs/score" },
    "s_match_infrastructure": { "$ref": "#/$defs/score" },
    "s_match_walk": { "$ref": "#/$defs/score" },
    "s_match_green": { "$ref": "#/$defs/score" },
    "s_match_transit": { "$ref": "#/$defs/score" },
    "s_match_quiet": { "$ref": "#/$defs/score" },
    "s_match_price": { "$ref": "#/$defs/score" },

    "s_rent_relative_city": { "$ref": "#/$defs/score" },
    "s_rent_absolute": { "$ref": "#/$defs/score" },
    "s_rent_absolute_legacy": { "$ref": "#/$defs/score" },
    "s_rent_strict": { "$ref": "#/$defs/score" },
    "s_rent_kalt_benchmark": { "$ref": "#/$defs/score" },
    "s_rent_value": { "$ref": "#/$defs/score" },
    "s_rent_warm": { "$ref": "#/$defs/score" },
    "s_rent_warm_strict": { "$ref": "#/$defs/score" },
    "rent_eur_m2": { "$ref": "#/$defs/nullableNumber", "description": "Cold rent €/m²" },
    "rent_monthly_est": { "$ref": "#/$defs/nullableNumber" },
    "rent_source": { "$ref": "#/$defs/nullableString" },
    "rent_confidence": { "$ref": "#/$defs/nullableString" },
    "rent_year": { "type": ["integer", "number", "string", "null"] },

    "center_min": { "$ref": "#/$defs/nullableNumber", "description": "Walk minutes to the main centre" },
    "center_min_best": { "$ref": "#/$defs/nullableNumber" },

    "dn_supermarket_min": { "$ref": "#/$defs/nullableNumber", "description": "Declared explicitly (not only via ^dn_) because hex-svc reads it by name" },
    "dn_pharmacy_min": { "$ref": "#/$defs/nullableNumber" },
    "dn_school_min": { "$ref": "#/$defs/nullableNumber" },
    "dn_kita_min": { "$ref": "#/$defs/nullableNumber" },
    "dn_doctor_min": { "$ref": "#/$defs/nullableNumber" },
    "dn_playground_min": { "$ref": "#/$defs/nullableNumber" },

    "urban_activity": { "$ref": "#/$defs/nullableNumber" },
    "business_count": { "$ref": "#/$defs/nullableNumber" },
    "transport_score": { "$ref": "#/$defs/nullableNumber" },
    "green_dist_m": { "$ref": "#/$defs/nullableNumber" },
    "green_access": { "$ref": "#/$defs/score" },
    "green_area_m2": { "$ref": "#/$defs/nullableNumber" },
    "green_quality": { "$ref": "#/$defs/nullableNumber" },
    "green_share_inside_500m": { "$ref": "#/$defs/nullableNumber" },
    "nearest_park_dist_m": { "$ref": "#/$defs/nullableNumber" },
    "nearest_park_area_ha": { "$ref": "#/$defs/nullableNumber" },
    "dist_water_m": { "$ref": "#/$defs/nullableNumber" },
    "tree_canopy_pct": { "$ref": "#/$defs/nullableNumber" },
    "noise_db": { "$ref": "#/$defs/nullableNumber" },
    "noise_source": { "$ref": "#/$defs/nullableString" },
    "noise_confidence": { "$ref": "#/$defs/nullableNumber" },
    "heat_source": { "$ref": "#/$defs/nullableString" },
    "heat_confidence": { "$ref": "#/$defs/nullableNumber" },
    "safety_source": { "$ref": "#/$defs/nullableString" },
    "safety_confidence": { "$ref": "#/$defs/nullableNumber" },
    "population_density": { "$ref": "#/$defs/nullableNumber" },
    "landuse_residential_share": { "$ref": "#/$defs/nullableNumber" },
    "landuse_commercial_share": { "$ref": "#/$defs/nullableNumber" },
    "data_quality": {
      "type": ["string", "null"],
      "enum": ["high", "mixed", "estimated", null]
    },

    "s_value_opportunity": { "$ref": "#/$defs/score" },
    "s_value_opportunity_raw": { "$ref": "#/$defs/nullableNumber" },
    "s_residential_quality": { "$ref": "#/$defs/score" },
    "voi_class": {
      "type": ["string", "null"],
      "enum": ["hidden_gem", "good_value", "normal", "overpriced", null]
    },
    "voi_confidence": {
      "type": ["string", "null"],
      "enum": ["high", "medium", "low", null]
    },
    "voi_explain": { "$ref": "#/$defs/nullableString" },
    "voi_highlight": { "type": ["integer", "number", "null"] },
    "voi_fair_rent_min": { "$ref": "#/$defs/nullableNumber" },
    "voi_fair_rent_max": { "$ref": "#/$defs/nullableNumber" },
    "voi_fair_rent_median": { "$ref": "#/$defs/nullableNumber" },
    "voi_expected_rent_eur_m2": { "$ref": "#/$defs/nullableNumber" },
    "voi_adjusted_price_gap": { "$ref": "#/$defs/nullableNumber" },
    "voi_price_gap": { "$ref": "#/$defs/nullableNumber" },
    "voi_location_premium": { "$ref": "#/$defs/nullableNumber" },
    "voi_local_advantage": { "$ref": "#/$defs/nullableNumber" },
    "voi_local_value_advantage": { "$ref": "#/$defs/nullableNumber" },
    "voi_local_delta": { "$ref": "#/$defs/nullableNumber" },
    "voi_gem_strength": { "$ref": "#/$defs/nullableNumber" }
  },
  "patternProperties": {
    "^dn_": { "type": ["number", "integer", "string", "null"], "description": "Daily-needs metric: *_min walk minutes, *_avail choice count, *_score" },
    "^dl_": { "$ref": "#/$defs/nullableNumber", "description": "Daily-life group score" },
    "^center_min_": { "$ref": "#/$defs/nullableNumber", "description": "Walk minutes to a named centre anchor" },
    "^wq_": { "$ref": "#/$defs/nullableNumber" },
    "^uf_": { "$ref": "#/$defs/nullableNumber" }
  },
  "x-consumers": {
    "$comment": "Keys each consumer reads. Tests in every language assert these are declared above, so removing a property in Python breaks CI instead of production.",
    "go-hex-svc": [
      "h3",
      "s_living",
      "s_daily_life",
      "s_walk",
      "s_green",
      "s_transit",
      "s_center",
      "s_quiet",
      "s_housing_value",
      "center_min",
      "dn_supermarket_min",
      "dn_pharmacy_min",
      "dn_school_min",
      "dn_kita_min",
      "dn_doctor_min",
      "dn_playground_min",
      "rent_eur_m2",
      "voi_class",
      "voi_explain"
    ],
    "frontend-scoring": [
      "h3",
      "s_living",
      "s_objective",
      "s_daily_life",
      "s_daily_needs",
      "s_walk",
      "s_walking_quality",
      "s_transit",
      "s_transit_service",
      "s_green",
      "s_green_strict",
      "s_quiet",
      "s_noise",
      "s_housing_affordability",
      "s_housing_value",
      "s_urban_form",
      "s_center",
      "s_center_strict",
      "s_urban_activity",
      "s_heat",
      "s_housing",
      "s_density",
      "s_traffic_safety",
      "s_rent_relative_city",
      "s_rent_absolute",
      "s_rent_kalt_benchmark",
      "center_min",
      "urban_activity",
      "business_count",
      "green_access",
      "green_share_inside_500m",
      "nearest_park_dist_m",
      "tree_canopy_pct",
      "noise_db",
      "population_density",
      "rent_eur_m2",
      "rent_confidence",
      "data_quality"
    ]
  },
  "$defs": {
    "score": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "0-100 score, null when inputs were missing"
    },
    "nullableNumber": { "type": ["number", "integer", "null"] },
    "nullableString": { "type": ["string", "null"] }
  }
}
